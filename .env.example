# ===== 部署到 Vercel 所需的环境变量 =====
# 在 Vercel 项目设置 -> Environment Variables 里逐个添加（下面的值都要换成你自己的）

# 1) 进门密码（登录用，务必改成你自己的强密码）
SITE_PASSWORD=LifeHub@2026

# 2) 会话密钥（登录 cookie 签名用，随机长字符串即可，勿外泄）
APP_SESSION_SECRET=9f2c7a1e4b8d6c3a5e0f9b2c7a1e4b8d6c3a5e0f9b2c7a1e4b8d6c3a5e0f9b2

# 3) Neon Postgres 数据库连接串（在 Neon 控制台复制，建议用 Pooled 连接串）
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# 4) DeepSeek（AI 助手）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
